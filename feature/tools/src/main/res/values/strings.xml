<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AI tool panel: network client errors. -->
    <!-- Shown when the AI provider sends an error inside the response stream
         and gives no message of its own. -->
    <string name="ftools_ai_stream_error">The AI provider ended the response with an error</string>

    <!-- Background photos: what a failed request tells the user. The picker
         resolves these where it draws them, so a language change is picked up. -->
    <string name="ftools_photo_error_offline">The app cannot reach the photo service. Check your network and try again.</string>
    <string name="ftools_photo_error_timeout">The photo service took too long to answer</string>
    <string name="ftools_photo_error_failed">The app could not get the photos</string>

    <!-- Search on the F-Droid build goes to a SearXNG instance the user names.
         403 from one nearly always means its JSON format is off, which is one
         line of its settings.yml, so say that rather than "Forbidden". -->
    <string name="ftools_search_error_json_disabled">This SearXNG instance has not enabled its JSON API. Add <![CDATA[<b>json</b>]]> to <![CDATA[<b>search.formats</b>]]> in its settings.yml, or use another instance.</string>
    <string name="ftools_search_error_searx_limited">This SearXNG instance is turning away apps for now (HTTP 429). Public instances limit requests that don\'t come from a browser. Try again later, or use an instance of your own or one that allows its JSON API.</string>

    <!-- AI tool calling (#470). These are not shown to the user: they are
         handed back to the model as the result of the tool it asked for, so
         it can say what went wrong in its own answer, in the user's language.
         Translated all the same, because a model answers better when the
         failure it is reading is in the language it is writing. -->
    <!-- The model asked to read a page but gave something that is not a web address. -->
    <string name="ftools_web_fetch_bad_url">That is not a web address this keyboard will open. Give a full http:// or https:// address.</string>
    <!-- The model asked to search but the user has set up no search service. -->
    <string name="ftools_ai_tool_no_search">Web search is not set up in this keyboard, so searching is not possible. Answer from what you already know and say that you could not search.</string>
    <!-- A tool ran and failed; the model is told so it can answer anyway. -->
    <string name="ftools_ai_tool_failed">The tool failed: %1$s. Do not call it again with the same input.</string>
    <!-- The model asked for a tool that does not exist. -->
    <string name="ftools_ai_tool_unknown">There is no tool called %1$s.</string>
    <!-- A required argument was missing from the call. -->
    <string name="ftools_ai_tool_missing_argument">The call left out the required \"%1$s\" value.</string>
    <!-- A search that ran but matched nothing. -->
    <string name="ftools_ai_tool_no_results">No results.</string>
    <!-- Appended to a fetched page that was cut at the character budget. -->
    <string name="ftools_ai_tool_truncated">[the page continues past this point and was cut]</string>

    <!-- Why a tool call failed, as the AI chat and the AI panel show it under
         the answer. Unlike the strings above, these are for the user. -->
    <!-- The model asked to search but the user has set up no search service. -->
    <string name="ftools_ai_tool_reason_no_search">Web search is not set up</string>
    <!-- The model asked for a tool that does not exist. -->
    <string name="ftools_ai_tool_reason_unknown">The model asked for a tool that does not exist</string>
    <!-- The model left out a required value; %1$s is its name, such as "query" or "url". -->
    <string name="ftools_ai_tool_reason_missing">The model left out the %1$s</string>
    <!-- The model asked to read something that is not an http or https address. -->
    <string name="ftools_ai_tool_reason_bad_url">Not a web address the keyboard will open</string>

    <!-- MCP servers the user added to the AI tool (#573). For the model:
         handed back as the result of a call. -->
    <!-- The user pressed Deny on the approval card. -->
    <string name="ftools_mcp_declined">The user did not allow this call. Do not call this tool again in this answer. Answer without it, and say what you could not do.</string>
    <!-- The run was stopped while the approval card was showing. -->
    <string name="ftools_mcp_stopped">The call was cancelled before it ran.</string>
    <!-- The tool sent back pictures, sound or files; %1$s lists their kinds, such as "image, audio". -->
    <string name="ftools_mcp_omitted">[the tool also sent back content you cannot read here: %1$s]</string>
    <!-- The tool's answer was cut at the character budget. -->
    <string name="ftools_mcp_truncated">[the answer continues past this point and was cut]</string>
    <!-- The tool ran but sent back nothing. -->
    <string name="ftools_mcp_empty">The tool ran and sent back nothing.</string>
    <!-- The tool itself reported a failure; %1$s is what it said. -->
    <string name="ftools_mcp_tool_error">The tool reported an error: %1$s</string>

    <!-- MCP failures for the user: under an answer, and on the server's settings page. -->
    <!-- The user pressed Deny. -->
    <string name="ftools_mcp_reason_declined">You did not allow it</string>
    <!-- The run was stopped while the card asked. -->
    <string name="ftools_mcp_reason_stopped">Stopped before it ran</string>
    <!-- The server needs an OAuth sign-in. -->
    <string name="ftools_mcp_error_sign_in">This server needs you to sign in, and the keyboard cannot do that yet. If the server gives out tokens or keys, add one as a header.</string>
    <!-- The address answered, but not like an MCP server. -->
    <string name="ftools_mcp_error_not_mcp">This address did not answer like an MCP server. Check the address and the type.</string>
    <!-- The server answered with an error; %1$s is its own words. -->
    <string name="ftools_mcp_error_server">The server sent an error: %1$s</string>
    <!-- The server wants an answer from the user or a model before it can finish. -->
    <string name="ftools_mcp_error_needs_input">The server asked for more input, and the keyboard cannot give it yet.</string>
    <!-- The server only speaks versions of the protocol this keyboard does not. -->
    <string name="ftools_mcp_error_no_version">This server uses a newer version of MCP than the keyboard knows.</string>
    <!-- The server was removed or turned off after the model saw its tool. -->
    <string name="ftools_mcp_error_gone">This server is turned off or was removed</string>
    <!-- The tool reported a failure of its own. -->
    <string name="ftools_mcp_reason_tool_error">The tool reported an error</string>
</resources>
