<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-build-only additions.

    The Harper spell checker lives here rather than in the main manifest
    because lite builds ship no libharper_jni.so: declaring the service
    there would list a spell checker in Android's system settings that can
    never return a result.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WMFullApplication starts WorkManager on first use (ML Kit's ink model
         downloads), so its androidx.startup initializer is taken out of every
         process start, the keyboard's included. -->
    <application
        android:name="com.wasimaster.wmkeyboard.app.WMFullApplication"
        tools:replace="android:name">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <service
            android:name="com.wasimaster.wmkeyboard.spell.HarperSpellCheckerService"
            android:exported="true"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>
    </application>

</manifest>
